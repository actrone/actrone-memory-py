# ============================================================
#  actrone-memory — Environment Variables
#  Copy this file to .env and fill in your own values.
#
#  cp .env.example .env
# ============================================================


# ── Storage ─────────────────────────────────────────────────
#
# Where your Redis server is running.
# Use rediss:// (double s) if your Redis requires TLS.
ACTRONE_REDIS_URL=redis://localhost:6379

# Where your Qdrant server is running.
# For Qdrant Cloud, use the cluster URL they give you.
ACTRONE_QDRANT_URL=http://localhost:6333

# Only required if you're using Qdrant Cloud (leave blank for self-hosted).
ACTRONE_QDRANT_API_KEY=


# ── Embeddings ───────────────────────────────────────────────
#
# Which provider to use for converting text into memory vectors.
# Options: "openai" (default) or "local" (free, no API key needed).
ACTRONE_EMBEDDING_PROVIDER=openai

# Your OpenAI API key — required when EMBEDDING_PROVIDER=openai.
# Get one at https://platform.openai.com/api-keys
ACTRONE_OPENAI_API_KEY=sk-...

# Advanced: change the embedding model (default is fine for most projects).
# ACTRONE_EMBEDDING_MODEL=text-embedding-3-small
# ACTRONE_EMBEDDING_DIMENSIONS=1536


# ── Short-Term Memory (Redis) ────────────────────────────────
#
# How long a session's short-term memory lasts before it expires.
# Default: 24 hours.
ACTRONE_SESSION_TTL_HOURS=24

# Maximum number of recent messages kept per session.
# Older messages are dropped once this limit is reached.
# Default: 50.
ACTRONE_MAX_SESSION_TURNS=50


# ── Long-Term Memory (Qdrant) ────────────────────────────────
#
# The name of the Qdrant collection where memories are stored.
# Default: agent_memories. Change this if you want to separate
# memories between different projects or environments.
# ACTRONE_QDRANT_COLLECTION=agent_memories

# How similar a past memory must be to the current query before
# it gets included. A score of 0.0 means include everything;
# 1.0 means only exact matches. 0.72 is a good starting point.
ACTRONE_RELEVANCE_THRESHOLD=0.72


# ── Auto-Summarisation ───────────────────────────────────────
#
# When enabled, old messages are automatically compressed into
# long-term memory so they remain searchable even after the
# short-term memory expires.
ACTRONE_AUTO_SUMMARISE=true

# How many messages to wait before triggering a summarisation.
ACTRONE_SUMMARISE_AFTER_TURNS=20


# ── Token Budget Fractions ───────────────────────────────────
#
# These control how the token budget is split between different
# types of context. They must add up to exactly 1.0.
# (You probably don't need to change these.)
#
# ACTRONE_BUDGET_FRACTION_SYSTEM=0.30
# ACTRONE_BUDGET_FRACTION_EPISODIC=0.25
# ACTRONE_BUDGET_FRACTION_SESSION=0.35
# ACTRONE_BUDGET_FRACTION_CURRENT_TURN=0.10
