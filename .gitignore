# Hardening 2026-11-05: env files (only the example is committed)
.env.*

# Hardening 2026-11-05: logs
*.log

# Hardening 2026-11-05: key material
*.pem
*.key
*.p12
*.pfx

# Hardening 2026-11-05: Windows (Git Bash crash dumps)
*.stackdump

# Hardening 2026-11-05: Windows (download marks)
*:Zone.Identifier

# Hardening 2026-11-05: scratch files
*.tmp
*.bak

# Hardening 2026-11-05: merge leftovers
*.orig
*.rej

# Hardening 2026-11-05: editor backups
*~

# Re-allow the committed example after the .env.* rule above
!.env.example
